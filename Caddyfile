# Caddyfile — IGS produção
# Caddy obtém e renova SSL automaticamente via Let's Encrypt
# DOMAIN deve ser definido no .env (ex: igs-anchieta.duckdns.org)
# Sem domínio: use o IP com DOMAIN= vazio → escuta em :80

{
    # Configurações globais
    admin off
    # Log global — rotação automática (10MB max, 5 arquivos mantidos)
    log {
        output file /var/log/caddy/caddy.log {
            roll_size 10MiB
            roll_keep 5
            roll_keep_for 720h
        }
        format json
        level INFO
    }
}

{$DOMAIN::80} {

    # ── API Backend ───────────────────────────────────────────
    handle /api/* {
        reverse_proxy api:8000
    }

    # ── WebSocket ─────────────────────────────────────────────
    handle /ws/* {
        reverse_proxy api:8000
    }

    # ── Frontend estático (React SPA) ─────────────────────────
    handle {
        reverse_proxy frontend:80
    }

    # ── Headers de segurança ──────────────────────────────────
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
