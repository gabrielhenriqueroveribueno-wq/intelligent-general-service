# ══════════════════════════════════════════════════════════════════════════════
# IGS — Ambiente de Produção
# Copie para .env e preencha TODOS os valores marcados com CHANGE_ME
# NUNCA suba este arquivo com valores reais para o git
# ══════════════════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false

# Domínio público da API (ex: api.minhaigs.com.br)
# Deixe vazio para usar só com IP sem HTTPS
DOMAIN=

# Gere com: openssl rand -hex 32
APP_SECRET_KEY=CHANGE_ME_64_CHARS

# ── Banco de Dados ────────────────────────────────────────────────────────────
POSTGRES_DB=igs_db
POSTGRES_USER=igs_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://igs_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/igs_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── JWT ───────────────────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_64_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Criptografia (CPF, tokens sensíveis no banco) ─────────────────────────────
# Gere com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# ── Claude API (Anthropic) ────────────────────────────────────────────────────
# Obtenha em: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
CLAUDE_MODEL=claude-opus-4-6
CLAUDE_MAX_TOKENS=1024

# ── WhatsApp Business API (Meta) ──────────────────────────────────────────────
# Obtenha em: https://developers.facebook.com → seu app → WhatsApp → Configuração
WHATSAPP_APP_SECRET=CHANGE_ME
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_TOKEN_ALEATORIO

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Para Gmail: use senha de app em: Minha conta → Segurança → Senhas de app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME@gmail.com
SMTP_PASSWORD=CHANGE_ME_APP_PASSWORD
SMTP_FROM=noreply@minhaigs.com.br

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://CHANGE_ME_DOMAIN

# ── Prometheus ────────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=false
