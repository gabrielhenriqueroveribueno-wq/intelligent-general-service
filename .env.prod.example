# ══════════════════════════════════════════════════════════════════════════════
# IGS Production Environment — NEVER commit .env.prod to git
# ══════════════════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=CHANGE_ME_TO_64_CHAR_RANDOM_STRING
DOMAIN=igs.yourdomain.com

# ── Database (superuser — used only for migrations) ──────────────────────────
POSTGRES_DB=igs_db
POSTGRES_USER=igs_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ── RLS Roles ────────────────────────────────────────────────────────────────
RLS_ENABLED=true
RLS_APP_PASSWORD=CHANGE_ME_APP_ROLE_PASSWORD
RLS_WORKER_PASSWORD=CHANGE_ME_WORKER_ROLE_PASSWORD

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_64_CHAR_RANDOM_STRING

# ── Encryption ───────────────────────────────────────────────────────────────
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# ── WhatsApp ─────────────────────────────────────────────────────────────────
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ── AI ───────────────────────────────────────────────────────────────────────
AI_PROVIDER=groq
GROQ_API_KEY=

# ── Tailscale ────────────────────────────────────────────────────────────────
TAILSCALE_AUTHKEY=tskey-auth-XXXXXXX

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
