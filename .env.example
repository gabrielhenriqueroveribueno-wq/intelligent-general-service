# ============================================================
# IGS - Intelligent General Service
# Copie este arquivo para .env e preencha os valores
# ============================================================

# --- App ---
APP_ENV=development
APP_SECRET_KEY=sua-chave-secreta-aqui-mude-em-producao
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Banco de Dados ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=igs_db
POSTGRES_USER=igs_user
POSTGRES_PASSWORD=igs_password
DATABASE_URL=postgresql+asyncpg://igs_user:igs_password@postgres:5432/igs_db

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- JWT ---
JWT_SECRET_KEY=sua-chave-jwt-secreta-mude-em-producao
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- WhatsApp Business API (Meta) ---
# Obtenha em: https://developers.facebook.com
WHATSAPP_APP_SECRET=seu-app-secret-meta
WHATSAPP_VERIFY_TOKEN=seu-token-de-verificacao
# Estes são por tenant (configurado no painel admin):
# WHATSAPP_ACCESS_TOKEN=EAAxxxx
# WHATSAPP_PHONE_NUMBER_ID=123456789

# --- Claude API (Anthropic) ---
# Obtenha em: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui
CLAUDE_MODEL=claude-opus-4-6
CLAUDE_MAX_TOKENS=1024

# --- Mercado Pago (Pagamentos PIX + Cartão) ---
# Obtenha em: https://www.mercadopago.com.br/developers
MP_ACCESS_TOKEN=APP_USR-xxxx
MP_PUBLIC_KEY=APP_USR-xxxx
MP_WEBHOOK_SECRET=

# --- Criptografia (para CPF, tokens sensíveis) ---
ENCRYPTION_KEY=sua-chave-fernet-32-bytes-base64

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend URL (para links de reset de senha) ---
FRONTEND_URL=http://localhost:3000

# --- Prometheus ---
PROMETHEUS_ENABLED=true

# --- Super Admin Inicial (para seed) ---
SUPER_ADMIN_EMAIL=admin@igs.com
SUPER_ADMIN_PASSWORD=Admin@123456
SUPER_ADMIN_NAME=IGS Admin

# --- Web Push (VAPID) ---
# Gere com: openssl ecparam -name prime256v1 -genkey -noout -out vapid_private.pem
#           openssl ec -in vapid_private.pem -pubout -out vapid_public.pem
# Ou use: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@igs.com.br

# --- Sentry (error tracking) ---
# Obtenha em: https://sentry.io → Settings → Projects → Client Keys
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.05

# --- Email via Resend (preferido) ---
# Obtenha em: https://resend.com → API Keys
# Se não configurado, usa SMTP abaixo como fallback
RESEND_API_KEY=

# --- SMTP Fallback ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
SMTP_FROM_EMAIL=noreply@igs.com.br
SMTP_USE_TLS=true

# --- SaaS Billing (cobrança dos tenants) ---
# URL que o MP usa para notificar pagamentos do plano SaaS
SAAS_BILLING_NOTIFICATION_URL=https://seu-dominio.com/api/v1/billing/webhook

# --- Google Analytics (frontend) ---
# Obtenha em: https://analytics.google.com → Admin → Data Streams
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
